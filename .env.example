# RecoverAI environment configuration
# Copy this file to backend/.env and adjust as needed.
# All backend commands (alembic, seed, uvicorn) run from the backend/ directory.

# PostgreSQL connection string (matches the local development database
# provisioned on the existing PostgreSQL server, and docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://recoverai:recoverai@localhost:5432/recoverai

# Razorpay webhook secret (HMAC-SHA256 of the raw request body, sent in the
# X-Razorpay-Signature header). Leave empty in development to accept
# unsigned webhooks; set it whenever the endpoint is exposed externally.
RAZORPAY_WEBHOOK_SECRET=

# GLM 5.3 structured tool calling (OpenAI-compatible /chat/completions
# endpoint of the configured agent router). Leave AGENT_LLM_BASE_URL or
# AGENT_LLM_API_KEY empty to run the agent in deterministic rule-based
# fallback mode: tests and offline demos never call the LLM.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=agentrouter/glm-5.3
AGENT_MAX_TOOL_CALLS=6

# Recovery scoring thresholds (Phase 6). A 0-100 deterministic weighted
# score is computed for every diagnosed case: >= SCORE_HIGH_THRESHOLD is
# eligible for a full recovery action, between the thresholds selects a
# cautious action, and below SCORE_STOP_THRESHOLD stops the case.
SCORE_HIGH_THRESHOLD=80
SCORE_STOP_THRESHOLD=35

# Safety gate (Phase 7): how many times a BLOCKed action may be re-selected
# to a safe alternative (rule 9) before the case escalates instead.
GATE_RESELECTION_BUDGET=1

# Recovery action execution (Phase 8). All execution is simulated: recovery
# payments are simulated rows and notifications are recorded, never delivered.
# Channel used by the action executor for simulated notifications.
DEFAULT_NOTIFICATION_CHANNEL=EMAIL

# Background scheduler (Phase 11). A single in-process asyncio loop over the
# durable background_jobs table: delayed verification, monitoring and the
# recurring expiry sweep. Set SCHEDULER_ENABLED=false to disable it (tests do).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=10
VERIFICATION_DELAY_SECONDS=30
SWEEP_INTERVAL_SECONDS=60
